---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const categories = [...new Set(posts.map(p => p.data.category))];
  return categories.map(cat => ({
    params: { slug: cat },
    props: { cat },
  }));
}

const { cat } = Astro.props;
const allPosts = await getCollection("posts");
const filtered = allPosts
  .filter(p => p.data.category === cat)
  .sort((a, b) => new Date(b.data.published) - new Date(a.data.published));
---

<BaseLayout title={cat} description={`分类：${cat}`}>
  <div class="layout">
    <div class="layout-main">
      <div class="page-header">
        <h1>{cat}</h1>
        <p class="subtitle">{filtered.length} 篇文章</p>
      </div>

      <ul class="post-list">
        {filtered.map((post) => {
          const d = post.data.published;
          const dateStr = `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
          return (
            <li class="post-item">
              <div class="date">{dateStr}</div>
              <h2><a href={`/posts/${post.slug}/`}>{post.data.title}</a></h2>
              <p class="excerpt">{post.data.description}</p>
              <div class="tags">
                {post.data.tags?.map((tag: string) => <span class="tag">{tag}</span>)}
              </div>
            </li>
          );
        })}
      </ul>
    </div>
    <div class="layout-sidebar">
      <Sidebar posts={allPosts} />
    </div>
  </div>
</BaseLayout>
