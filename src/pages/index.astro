---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.published) - new Date(a.data.published)
);
const latestPosts = sortedPosts.slice(0, 6);
---

<BaseLayout title="首页" description="王忠亮 - 个人学术博客">
  <div class="layout">
    <div class="layout-main">
      <section class="hero">
        <h1>你好，我是王忠亮</h1>
        <p class="subtitle">
          软件工程专业本科生，热爱编程与技术分享。
          这里记录我的学习笔记、项目经验与技术思考。
        </p>
        <div class="meta">
          <span>📍 软件工程</span>
          <span>💻 全栈开发 / 开源爱好者</span>
          <span>✉️ wzl2223096755@gmail.com</span>
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <h2 class="section-title">研究兴趣</h2>
          <div class="line"></div>
        </div>
        <div class="interests-grid">
          <span class="interest-tag"><span class="icon">⚛️</span> React / Next.js</span>
          <span class="interest-tag"><span class="icon">🐍</span> Python</span>
          <span class="interest-tag"><span class="icon">🦀</span> Rust</span>
          <span class="interest-tag"><span class="icon">☁️</span> 云计算</span>
          <span class="interest-tag"><span class="icon">🗄️</span> 数据库</span>
          <span class="interest-tag"><span class="icon">🤖</span> AI / 机器学习</span>
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <h2 class="section-title">最新动态</h2>
          <div class="line"></div>
        </div>
        <ul class="post-list">
          {latestPosts.map((post) => {
            const d = post.data.published;
            const dateStr = `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
            return (
              <li class="post-item">
                <div class="date">{dateStr}</div>
                <h2><a href={`/posts/${post.slug}/`}>{post.data.title}</a></h2>
                <p class="excerpt">{post.data.description}</p>
                <div class="tags">
                  {post.data.tags?.map((tag: string) => <span class="tag">{tag}</span>)}
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    </div>
    <div class="layout-sidebar">
      <Sidebar posts={posts} />
    </div>
  </div>
</BaseLayout>
