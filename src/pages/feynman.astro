---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/layout/Navbar.astro";
import { siteConfig } from "@/config";

const pageTitle = "费曼学习卡 · 习惯记录本";
const pageDescription = "基于费曼学习法和间隔重复算法的学习工具，帮助你更好地理解和记忆知识。";
const stickyNavbar = siteConfig.navbar.stickyNavbar ?? false;
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- 顶部导航栏 -->
  <div
    id="top-row"
    class:list={[
      "z-50 pointer-events-none relative w-full",
      stickyNavbar ? "fixed top-0 left-0 right-0" : "",
    ]}
  >
    <div class:list={["pointer-events-auto", stickyNavbar ? "" : "sticky top-0"]}>
      <Navbar />
    </div>
  </div>

  <!-- 费曼应用：全宽，无侧边栏约束 -->
  <div class="feynman-fullwidth">
    <!-- 云端同步控制栏 -->
    <div id="cloud-sync-bar" class="cloud-sync-bar">
      <div class="sync-controls">
        <button id="sync-settings-btn" class="sync-btn" title="云端同步设置">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </button>
        <span id="sync-status" class="sync-status"></span>
      </div>
    </div>
    
    <!-- 云端同步设置模态框 -->
    <div id="sync-settings-modal" class="sync-modal" style="display: none;">
      <div class="sync-modal-content">
        <button class="sync-modal-close" id="close-sync-modal">×</button>
        <h3 class="sync-modal-title">☁️ 云端同步设置</h3>
        
        <div id="sync-setup" class="sync-section">
          <p class="sync-hint">设置云端密钥后，你的数据将自动同步到云端，可以在不同设备间访问。</p>
          
          <div class="sync-form-group">
            <label for="cloud-passkey-input">云端密钥</label>
            <input 
              type="password" 
              id="cloud-passkey-input" 
              placeholder="输入一个密钥（至少6位）"
              autocomplete="off"
            />
            <small>密钥用于加密你的数据标识，请妥善保管。</small>
          </div>
          
          <div class="sync-actions">
            <button id="save-passkey-btn" class="sync-primary-btn">启用云端同步</button>
          </div>
        </div>
        
        <div id="sync-active" class="sync-section" style="display: none;">
          <div class="sync-info">
            <p>✅ 云端同步已启用</p>
            <p class="sync-last-sync">最后同步：<span id="last-sync-time">--</span></p>
          </div>
          
          <div class="sync-actions">
            <button id="manual-sync-btn" class="sync-secondary-btn">立即同步</button>
            <button id="disable-sync-btn" class="sync-danger-btn">禁用云端同步</button>
          </div>
        </div>
      </div>
    </div>
    
    <div id="app" class="loading-state">正在加载数据…</div>
  </div>
</Layout>>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');

  /* ===== 背景容器 + CSS 变量（与原始 HTML 完全一致，供 JS 模板 inline style 使用）===== */
  .feynman-fullwidth {
    width: 100%;
    padding: 32px 20px 64px;
    background-color: #F3F1EA;
    background-image:
      linear-gradient(rgba(47,76,116,0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(47,76,116,0.09) 1px, transparent 1px);
    background-size: 28px 28px;
    min-height: 100vh;
    box-sizing: border-box;
    --paper: #F3F1EA;
    --card: #FFFDF8;
    --ink: #23262B;
    --ink-soft: #5B5B54;
    --blue: #2F4C74;
    --blue-soft: rgba(47,76,116,0.10);
    --sage: #5C7A57;
    --sage-soft: rgba(92,122,87,0.14);
    --rust: #9C5642;
    --border: #DCD8C9;
  }

  @media (prefers-color-scheme: dark) {
    .feynman-fullwidth {
      background-color: #1a1a1a;
      background-image:
        linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
      --paper: #1a1a1a;
      --card: #242424;
      --ink: #e8e8e8;
      --ink-soft: #a0a0a0;
      --blue: #5B7FA3;
      --blue-soft: rgba(91,127,163,0.15);
      --sage: #7B9A76;
      --sage-soft: rgba(123,154,118,0.20);
      --rust: #B67662;
      --border: #3a3a3a;
    }
  }

  /* ===== #app 容器 ===== */
  #app {
    max-width: 980px;
    margin: 0 auto;
    padding: 0;
    font-family: 'IBM Plex Sans', sans-serif;
    color: var(--ink);
  }
  #app * { box-sizing: border-box; }

  /* ===== 布局：全部单列，从上到下 ===== */
  #app .layout {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin-bottom: 22px;
  }
  #app .new-card-form { position: static; margin-bottom: 18px; }

  /* ===== Panel ===== */
  #app .panel { background: var(--card); border: 1px solid var(--border); border-radius: 4px; padding: 20px; }
  #app .panel-title { font-family: 'Newsreader', serif; font-size: 18px; font-weight: 600; margin: 0 0 4px; color: var(--ink); }
  #app .panel-hint { font-size: 12.5px; color: var(--ink-soft); margin: 0 0 16px; line-height: 1.5; }

  /* ===== 按钮 ===== */
  #app button { font-family: 'IBM Plex Sans', sans-serif; cursor: pointer; border-radius: 3px; border: 1px solid transparent; }
  #app .btn-primary { background: var(--blue); color: #fff; border: none; padding: 9px 16px; font-size: 13.5px; font-weight: 500; }
  #app .btn-primary:hover { background: #26405E; }
  #app .btn-text { background: none; border: none; color: var(--ink-soft); font-size: 12px; padding: 4px 2px; text-decoration: underline; cursor: pointer; }
  #app .btn-text.danger { color: var(--rust); }

  /* ===== 输入框 ===== */
  #app input[type=text],
  #app input[type=password],
  #app input[type=number],
  #app textarea,
  #app select {
    width: 100%;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 13.5px;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--card);
    color: var(--ink);
    box-sizing: border-box;
  }
  #app textarea { resize: vertical; min-height: 54px; line-height: 1.55; white-space: pre-wrap; }
  #app input:focus, #app textarea:focus, #app select:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 2px var(--blue-soft); }
  #app label.field-label { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.03em; color: var(--blue); display: block; margin: 12px 0 4px; }
  #app label.field-label:first-child { margin-top: 0; }

  /* ===== 新建卡片表单 ===== */
  #app .new-card-form { margin-bottom: 18px; }
  #app .form-title { font-family: 'Newsreader', serif; font-size: 15px; font-weight: 600; margin-bottom: 4px; color: var(--blue); }
  #app .subject-row { display: flex; gap: 8px; }
  #app .subject-row select { width: 150px; flex: 0 0 auto; font-size: 13px; padding: 8px 10px; border: 1px solid var(--border); border-radius: 3px; background: var(--card); color: var(--ink); }
  #app .subject-row input { flex: 1; }
  #app .form-actions { margin-top: 12px; display: flex; align-items: center; gap: 10px; }

  /* ===== 科目筛选 ===== */
  #app .subject-filter { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  #app .filter-chip { font-family: 'IBM Plex Mono', monospace; font-size: 11px; padding: 4px 10px; border: 1px solid var(--border); border-radius: 3px; background: var(--card); color: var(--ink-soft); cursor: pointer; }
  #app .filter-chip:hover { border-color: var(--blue); color: var(--blue); }
  #app .filter-chip.active { background: var(--blue); border-color: var(--blue); color: #fff; }
  #app .search-bar { margin-bottom: 8px; }

  /* ===== 费曼卡片 ===== */
  #app .fcard-topic-wrap { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  #app .subject-tag { font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: var(--blue); letter-spacing: 0.02em; }
  #app .fcard { position: relative; border: 1px solid var(--border); border-radius: 2px; background: var(--card); padding: 13px 16px 13px 18px; margin-bottom: 10px; }
  #app .fcard::before { content: ''; position: absolute; left: 0; top: 10px; bottom: 10px; width: 3px; background: var(--blue-soft); border-radius: 2px; }
  #app .fcard.due { border-color: var(--rust); }
  #app .fcard.due::before { background: var(--rust); }
  #app .fcard.editing { border-color: var(--blue); box-shadow: 0 0 0 1px var(--blue); }
  #app .fcard-head { display: flex; justify-content: space-between; align-items: baseline; cursor: pointer; gap: 10px; }
  #app .fcard-topic { font-family: 'Newsreader', serif; font-size: 15.5px; font-weight: 500; color: var(--ink); }
  #app .fcard-date { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--ink-soft); white-space: nowrap; }
  #app .fcard-meta { display: flex; align-items: center; gap: 8px; white-space: nowrap; }
  #app .fcard-body { margin-top: 10px; display: none; }
  #app .fcard.open .fcard-body { display: block; }
  #app .fcard-step { margin-bottom: 8px; font-size: 13px; line-height: 1.6; white-space: pre-wrap; }
  #app .fcard-step .step-label { font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: var(--blue); display: block; margin-bottom: 2px; }
  #app .fcard-actions { margin-top: 8px; }

  /* ===== 复习按钮 ===== */
  #app .review-row { margin-top: 10px; }
  #app .review-btns { display: flex; gap: 6px; flex-wrap: wrap; }
  #app .review-btn { font-size: 12px; padding: 5px 12px; border-radius: 3px; border: 1px solid var(--border); background: var(--card); color: var(--ink); }
  #app .review-btn:hover { border-color: var(--blue); color: var(--blue); }
  #app .review-btn.again:hover { border-color: var(--rust); color: var(--rust); }
  #app .review-btn.good { border-color: var(--sage); color: var(--sage); }
  #app .review-btn.easy { border-color: var(--blue); color: var(--blue); }

  /* ===== 徽章 ===== */
  #app .badge { font-family: 'IBM Plex Mono', monospace; font-size: 10px; padding: 1px 6px; border-radius: 3px; }
  #app .badge-new { background: var(--blue-soft); color: var(--blue); }
  #app .badge-learning { background: var(--sage-soft); color: var(--sage); }
  #app .badge-relearn { background: var(--blue-soft); color: var(--rust); }
  #app .badge-mastered { background: #EDEDE9; color: var(--ink-soft); }
  #app .badge-due { background: var(--rust); color: #fff; }
  #app .due-badge { display: inline-block; background: var(--rust); color: #fff; font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 400; letter-spacing: 0.02em; padding: 2px 7px; border-radius: 3px; vertical-align: middle; margin-left: 6px; }
  #app .new-badge { display: inline-block; background: var(--blue-soft); color: var(--blue); font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 400; letter-spacing: 0.02em; padding: 2px 7px; border-radius: 3px; vertical-align: middle; margin-left: 6px; }

  /* ===== 盲点清单 ===== */
  #app .gap-bank { margin-top: 22px; border-top: 1px dashed var(--border); padding-top: 16px; }
  #app .gap-bank-title { font-family: 'Newsreader', serif; font-size: 15px; font-weight: 600; margin-bottom: 10px; color: var(--ink); }
  #app .gap-item { display: flex; gap: 8px; padding: 8px 10px; border: 1px solid var(--border); border-radius: 3px; margin-bottom: 8px; background: var(--card); }
  #app .gap-item.done { opacity: 0.55; }
  #app .gap-item.done .gap-text { text-decoration: line-through; }
  #app .gap-check { cursor: pointer; font-size: 15px; color: var(--sage); line-height: 1.4; user-select: none; }
  #app .gap-check:hover { color: var(--rust); }
  #app .gap-text { font-size: 13px; line-height: 1.55; }
  #app .gap-topic { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: var(--blue); margin-bottom: 2px; }

  /* ===== 习惯追踪 ===== */
  #app .habit-add-row { display: flex; gap: 8px; margin-bottom: 16px; }
  #app .week-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: var(--ink-soft); }
  #app .week-nav button { background: none; border: none; color: var(--blue); font-size: 12.5px; padding: 2px 4px; cursor: pointer; }
  #app .week-nav .btn-today { color: var(--rust); }
  #app .habit-streak { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: var(--rust); margin-top: 3px; }
  #app table.habit-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  #app table.habit-table th, #app table.habit-table td { text-align: center; padding: 6px 2px; }
  #app table.habit-table th { font-family: 'IBM Plex Mono', monospace; font-weight: 400; color: var(--ink-soft); font-size: 10px; }
  #app table.habit-table td.habit-name-cell { text-align: left; font-size: 12px; padding-right: 4px; max-width: 84px; word-break: break-word; line-height: 1.3; }
  #app th.is-today, #app td.is-today { background: var(--blue-soft); }
  #app th.is-today { color: var(--blue); }
  #app .check-box { width: 21px; height: 21px; border: 1px solid var(--border); border-radius: 3px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; background: var(--card); font-size: 12px; color: var(--sage); user-select: none; }
  #app .check-box.checked { background: var(--sage-soft); border-color: var(--sage); }
  #app .habit-row-remove { background: none; border: none; color: var(--ink-soft); font-size: 12px; cursor: pointer; padding: 0 0 0 3px; }
  #app .habit-row-remove:hover { color: var(--rust); }
  #app .streak-cell { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--sage); }

  /* ===== 计划表 ===== */
  #app .full-width { margin-top: 22px; }
  #app .schedule-wrap { overflow-x: auto; }
  #app table.schedule-table { width: 100%; border-collapse: collapse; font-size: 12px; min-width: 640px; }
  #app table.schedule-table th, #app table.schedule-table td { padding: 5px 4px; vertical-align: top; }
  #app table.schedule-table th { font-family: 'IBM Plex Mono', monospace; font-weight: 400; color: var(--ink-soft); font-size: 10.5px; text-align: center; }
  #app .slot-label-input { width: 100%; min-width: 64px; font-size: 11.5px; padding: 5px 6px; min-height: 36px; line-height: 1.4; resize: vertical; overflow: hidden; }
  #app .cell-input { width: 100%; min-width: 84px; font-size: 12px; padding: 5px 6px; min-height: 42px; resize: vertical; overflow: hidden; }
  #app .slot-row-remove { background: none; border: none; color: var(--ink-soft); font-size: 12px; cursor: pointer; padding: 6px 0 0 3px; vertical-align: top; }
  #app .slot-row-remove:hover { color: var(--rust); }
  #app .add-slot-row { margin-top: 10px; }

  /* ===== 统计栏 / 底部 / 空态 ===== */
  #app .stats-line { font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; color: var(--ink-soft); letter-spacing: 0.02em; margin-bottom: 14px; }
  #app .stats-line b { color: var(--blue); font-weight: 500; }
  #app .footer-note { margin-top: 24px; font-size: 11px; color: var(--ink-soft); text-align: center; }
  #app .loading-state { padding: 40px 0; text-align: center; color: var(--ink-soft); font-size: 13px; }
  #app .empty-state { font-size: 13px; color: var(--ink-soft); padding: 16px 0; text-align: center; border: 1px dashed var(--border); border-radius: 3px; }
  #app .tip-badge { display: inline-block; background: var(--blue); color: #fff; font-size: 10px; padding: 2px 6px; border-radius: 3px; margin-left: 6px; cursor: help; }

  /* ===== 弹窗（body 下直接 append 的，不在 #app 内）===== */
  .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 9999; display: flex; align-items: center; justify-content: center; }
  .modal-content { background: var(--card); border-radius: 8px; padding: 24px; max-width: 700px; width: 90%; max-height: 80vh; overflow-y: auto; box-shadow: 0 8px 32px rgba(0,0,0,0.2); }
  .modal-title { margin: 0 0 16px; font-family: 'Newsreader', serif; font-size: 20px; color: var(--ink); }
  .modal-close { float: right; background: none; border: none; font-size: 24px; color: var(--ink-soft); cursor: pointer; padding: 0; width: 32px; height: 32px; }
  .modal-close:hover { color: var(--rust); }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: 4px; padding: 12px; text-align: center; }
  .stat-value { font-family: 'Newsreader', serif; font-size: 28px; font-weight: 600; color: var(--blue); margin-bottom: 4px; }
  .stat-label { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: var(--ink-soft); }
  .progress-bar { width: 100%; height: 8px; background: var(--blue-soft); border-radius: 4px; overflow: hidden; margin-top: 8px; }
  .progress-fill { height: 100%; background: var(--blue); transition: width 0.3s ease; }

  /* 帮助系统（在 modal 内）*/
  .help-section { margin-bottom: 24px; }
  .help-kbd { display: inline-block; background: #f5f5f5; border: 1px solid var(--border); border-radius: 3px; padding: 2px 6px; font-family: 'IBM Plex Mono', monospace; font-size: 11px; margin: 0 2px; }
  .help-tip { background: var(--blue-soft); border-left: 3px solid var(--blue); padding: 12px; border-radius: 3px; margin: 12px 0; font-size: 12.5px; line-height: 1.6; }
  .help-warning { background: rgba(156,86,66,0.1); border-left: 3px solid var(--rust); padding: 12px; border-radius: 3px; margin: 12px 0; font-size: 12.5px; line-height: 1.6; }
  .help-tabs { display: flex; gap: 8px; margin-bottom: 16px; border-bottom: 2px solid var(--border); }
  .help-tab { padding: 8px 16px; background: none; border: none; font-size: 13px; cursor: pointer; color: var(--ink-soft); border-bottom: 2px solid transparent; margin-bottom: -2px; }
  .help-tab.active { color: var(--blue); border-bottom-color: var(--blue); font-weight: 500; }
  .help-content { display: none; }
  .help-content.active { display: block; }

  /* 欢迎引导（在 #app 内）*/
  #app .welcome-card { background: linear-gradient(135deg, var(--blue-soft) 0%, var(--sage-soft) 100%); border: 2px solid var(--blue); border-radius: 8px; padding: 24px; margin-bottom: 20px; }
  #app .welcome-title { font-family: 'Newsreader', serif; font-size: 22px; margin: 0 0 12px; color: var(--blue); }
  #app .welcome-steps { display: grid; gap: 12px; margin-top: 16px; }
  #app .welcome-step { background: var(--card); border-radius: 4px; padding: 12px; display: flex; gap: 12px; align-items: flex-start; }
  #app .welcome-step-num { background: var(--blue); color: #fff; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 14px; flex-shrink: 0; }
  #app .welcome-step-title { font-weight: 500; font-size: 13.5px; margin-bottom: 4px; }
  #app .welcome-step-desc { font-size: 12px; color: var(--ink-soft); line-height: 1.5; }
  #app .welcome-actions { display: flex; gap: 10px; margin-top: 16px; }

  /* ===== 云端同步控制栏 ===== */
  .cloud-sync-bar { position: fixed; top: 80px; right: 20px; z-index: 1000; background: var(--card); border: 1px solid var(--border); border-radius: 6px; padding: 6px 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
  .sync-controls { display: flex; align-items: center; gap: 8px; }
  .sync-btn { background: none; border: none; color: var(--ink-soft); padding: 6px; cursor: pointer; border-radius: 4px; display: flex; align-items: center; }
  .sync-btn:hover { background: var(--blue-soft); color: var(--blue); }
  .sync-status { font-size: 11px; font-family: 'IBM Plex Mono', monospace; color: var(--ink-soft); min-width: 50px; }
  .sync-status.syncing { color: var(--blue); animation: sync-pulse 1.5s ease-in-out infinite; }
