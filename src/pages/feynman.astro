---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const pageTitle = "费曼学习卡 · 习惯记录本";
const pageDescription = "基于费曼学习法和间隔重复算法的学习工具，帮助你更好地理解和记忆知识。";
---

<MainGridLayout title={pageTitle} description={pageDescription}>
  <div class="feynman-page-container">
    <div id="app" class="loading-state">正在加载数据…</div>
  </div>
</MainGridLayout>

<style is:global>
  @import "../styles/feynman.css";
</style>

<style>
  .feynman-page-container {
    /* 扩展到全宽，覆盖博客默认容器样式 */
    margin: -2.5rem -2.5rem 0;
    padding: 0;
    min-height: 600px;
  }
  
  @media (max-width: 768px) {
    .feynman-page-container {
      margin: -1.5rem -1.5rem 0;
    }
  }
</style>

<script is:inline src="/feynman-app.js"></script>
