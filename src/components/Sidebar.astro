---
import SiteStats from "./SiteStats.astro";
import type { CollectionEntry } from "astro:content";

type Post = CollectionEntry<"posts">;

const { posts = [] as Post[] } = Astro.props;

const tagMap = new Map<string, number>();
const categoryMap = new Map<string, number>();
for (const post of posts) {
  const cat = post.data.category;
  categoryMap.set(cat, (categoryMap.get(cat) || 0) + 1);
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  }
}
const sortedTags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);
const sortedCategories = [...categoryMap.entries()].sort((a, b) => b[1] - a[1]);
---

<aside class="sidebar">
  <div class="sidebar-widget">
    <h3>站点数据</h3>
    <SiteStats
      postCount={posts.length}
      tagCount={tagMap.size}
      categoryCount={categoryMap.size}
    />
  </div>

  <div class="sidebar-widget">
    <h3>分类</h3>
    <ul class="sidebar-category-list">
      {sortedCategories.map(([cat, count]) => (
        <li>
          <a href={`/category/${cat}/`}>{cat}</a>
          <span class="count">{count}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="sidebar-widget">
    <h3>标签</h3>
    <div class="sidebar-tag-cloud">
      {sortedTags.slice(0, 20).map(([tag]) => (
        <a href={`/tag/${encodeURIComponent(tag)}/`}>#{tag}</a>
      ))}
    </div>
  </div>
</aside>
